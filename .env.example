# Copy to .env.local for local development; set the same keys in Vercel → Project → Environment Variables.

# Base URL of the PalmPay backend (defaults to http://localhost:8000). Must be https:// in production.
NEXT_PUBLIC_API_URL=

# Optional in-browser hand detection tuning (defaults: 120 ms, GPU with automatic CPU fallback).
NEXT_PUBLIC_DETECTION_INTERVAL_MS=
NEXT_PUBLIC_MEDIAPIPE_DELEGATE=
