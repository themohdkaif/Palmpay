# Copy to backend/.env. Every value is optional — empty values fall back to the defaults noted below.

# Razorpay credentials. Leave empty to run with mock payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Issue a mock mandate token at enrollment (default: true)
AUTO_APPROVE_MANDATE=

# Cosine-similarity thresholds for identify (scan 1) and authorize (scan 2) (default: 0.58 each)
MATCH_THRESHOLD=
VERIFY_THRESHOLD=

# Comma-separated allowed origins, e.g. https://your-app.vercel.app (default: *)
CORS_ORIGINS=

# Storage (defaults: sqlite:///<backend>/data/palmpay.db and <backend>/data/receipts)
DATABASE_URL=
RECEIPTS_DIR=

# Model artifacts (defaults: assets/hand_landmarker.task and assets/pca.joblib)
HAND_LANDMARKER_MODEL=
PALM_PCA_PATH=
